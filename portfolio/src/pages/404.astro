---
/* PAGE 404 — GitHub Pages sert dist/404.html pour toute adresse inconnue du site */
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Page introuvable | Brandon Chhoeum" description="Cette page n'existe pas ou a déménagé. Retrouvez l'accueil, les projets ou la page de contact du portfolio de Brandon Chhoeum." preloadHero>
    <Nav />

    <main>
        <section class="relative flex min-h-screen items-center overflow-hidden">
            <div
                class="absolute inset-0 scale-105 bg-cover bg-center blur-[3px]"
                style={`background-image: url('${base}images/bg_hero_index.webp');`}
                aria-hidden="true"
            ></div>
            <div class="absolute inset-0 bg-cuir-950/70" aria-hidden="true"></div>

            <div class="relative z-10 mx-auto w-full max-w-7xl px-6 py-32">
                <div class="max-w-3xl">
                    <div class="mb-6">
                        <span class="badge badge-accent">✦ Erreur 404</span>
                    </div>

                    <h1 class="text-5xl font-bold leading-tight text-parchemin-50 md:text-6xl">
                        Ce chemin s'est perdu
                        <span class="text-accent-300">dans le brouillard.</span>
                    </h1>

                    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-parchemin-200 md:text-xl">
                        La page que vous cherchez n'existe pas, ou elle a changé d'adresse.
                        Reprenez la route depuis l'un de ces lieux connus.
                    </p>

                    <div class="mt-8 flex flex-col gap-4 sm:flex-row">
                        <a href={base} class="btn btn-primary">
                            Retour à l'accueil <span class="arrow">→</span>
                        </a>
                        <a href={`${base}projects/`} class="btn btn-secondary">
                            Voir mes projets
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <script>
        /* Les anciennes adresses (avant Astro) mènent ici : on renvoie vers leur nouvel emplacement. */
        const base = import.meta.env.BASE_URL;
        const oldPath = location.pathname.slice(base.length - 1);
        const moved = { "/index.html": "", "/src/projet/resume/resume.html": "projet/resume/" };
        const page = oldPath.match(/^\/src\/pages\/(about|projects|wip|contact)\.html$/);
        const target = page ? `${page[1]}/` : moved[oldPath];

        if (target !== undefined) {
            location.replace(`${base}${target}${location.hash}`);
        }
    </script>
</BaseLayout>
