---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import "../styles/wip.css";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Rôle & Fairies | Brandon Chhoeum" description="Rôle & Fairies, projet web en cours autour de D&D 5.5e : fonctionnalités envisagées, progression, roadmap et apprentissages (JavaScript, React, Three.js)." bodyClass="wip-page">
    <Nav active="wip" />

    <main>
        <!-- HERO -->
        <section class="wip-hero">
            <div class="wip-hero-glow" aria-hidden="true"></div>

            <div class="wip-hero-content">
                <span class="badge badge-accent">✦ Projet personnel · En développement</span>

                <h1>Rôle &amp; Fairies.</h1>

                <p>
                    Un projet pensé comme une véritable boîte à outils
                    pour les aventures de jeu de rôle, mais surtout comme
                    un terrain d'expérimentation pour apprendre,
                    construire et explorer le développement web.
                </p>

                <div class="wip-hero-actions">
                    <a href="#progression" class="btn btn-primary">Voir la progression</a>
                    <a href="#roadmap" class="btn btn-secondary">Explorer la roadmap</a>
                </div>
            </div>
        </section>

        <!-- INTRODUCTION -->
        <section class="section">
            <div class="section-heading">
                <p class="section-eyebrow">✦ Le grimoire</p>
                <h2 class="section-title">Une aventure qui commence à peine.</h2>
                <p class="section-description">
                    Rôle &amp; Fairies est un projet volontairement ambitieux.
                    Je souhaite le construire progressivement, fonctionnalité
                    après fonctionnalité, en utilisant chaque nouvelle étape
                    comme une occasion d'apprendre quelque chose.
                </p>
            </div>

            <div class="wip-intro-grid">
                <article class="fantasy-info-card">
                    <span class="fantasy-card-icon" aria-hidden="true">🧙</span>
                    <h3>Pourquoi ce projet ?</h3>
                    <p>
                        Parce que j'aime le jeu de rôle, les univers
                        fantastiques et les projets qui permettent de
                        mélanger créativité et programmation.
                    </p>
                </article>

                <article class="fantasy-info-card">
                    <span class="fantasy-card-icon" aria-hidden="true">⚒️</span>
                    <h3>Un terrain d'apprentissage</h3>
                    <p>
                        Chaque fonctionnalité représente une nouvelle
                        problématique technique à résoudre et une nouvelle
                        compétence à développer.
                    </p>
                </article>

                <article class="fantasy-info-card">
                    <span class="fantasy-card-icon" aria-hidden="true">📜</span>
                    <h3>Une construction progressive</h3>
                    <p>
                        Le projet est pensé pour évoluer sur le long terme.
                        Certaines idées sont déjà définies, d'autres
                        apparaîtront au fil de mes apprentissages.
                    </p>
                </article>
            </div>
        </section>

        <!-- PROGRESSION -->
        <section id="progression" class="section">
            <div class="section-heading">
                <p class="section-eyebrow">✦ État de l'aventure</p>
                <h2 class="section-title">Progression du projet.</h2>
                <p class="section-description">
                    Le projet avance par étapes. Certaines fonctionnalités
                    sont terminées, d'autres sont actuellement étudiées
                    ou encore inscrites dans mes prochaines aventures.
                </p>
            </div>

            <div class="progress-book">
                <div class="progress-book-header">
                    <div>
                        <span class="progress-book-label">Chapitre actuel</span>
                        <h3>Fondations &amp; exploration</h3>
                    </div>
                    <strong>15%</strong>
                </div>

                <div class="progress-track" role="progressbar" aria-valuenow="15" aria-valuemin="0" aria-valuemax="100" aria-label="Avancement du projet">
                    <div class="progress-fill" style="width: 15%"></div>
                </div>

                <div class="progress-stats">
                    <div>
                        <strong>01</strong>
                        <span>fonctionnalité explorée</span>
                    </div>
                    <div>
                        <strong>08</strong>
                        <span>grands systèmes imaginés</span>
                    </div>
                    <div>
                        <strong>∞</strong>
                        <span>idées à explorer</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- FONCTIONNALITÉS : cartes générées par wip.js -->
        <section class="section">
            <div class="section-heading">
                <p class="section-eyebrow">✦ Le contenu du grimoire</p>
                <h2 class="section-title">Les fonctionnalités envisagées.</h2>
                <p class="section-description">
                    Le projet est composé de plusieurs systèmes indépendants
                    qui pourront progressivement former une application
                    complète.
                </p>
            </div>

            <div id="features-grid" class="wip-feature-grid"></div>
        </section>

        <!-- ROADMAP -->
        <section id="roadmap" class="section">
            <div class="section-heading">
                <p class="section-eyebrow">✦ La route</p>
                <h2 class="section-title">La roadmap de l'aventure.</h2>
                <p class="section-description">
                    Les étapes ne sont pas figées. Elles représentent
                    surtout les directions que je souhaite explorer.
                </p>
            </div>

            <div class="roadmap">
                <div class="roadmap-line" aria-hidden="true"></div>

                <article class="roadmap-item completed">
                    <div class="roadmap-point" aria-hidden="true">✓</div>
                    <div class="roadmap-card">
                        <span>Étape I</span>
                        <h3>Imaginer l'univers</h3>
                        <p>
                            Définir l'identité du projet, ses objectifs,
                            ses fonctionnalités principales et son
                            organisation générale.
                        </p>
                        <small>Terminé</small>
                    </div>
                </article>

                <article class="roadmap-item current">
                    <div class="roadmap-point" aria-hidden="true">◐</div>
                    <div class="roadmap-card">
                        <span>Étape II</span>
                        <h3>Construire les fondations</h3>
                        <p>
                            Approfondir JavaScript, structurer les données
                            et expérimenter différentes interfaces
                            interactives.
                        </p>
                        <small>En cours</small>
                    </div>
                </article>

                <article class="roadmap-item">
                    <div class="roadmap-point" aria-hidden="true">✦</div>
                    <div class="roadmap-card">
                        <span>Étape III</span>
                        <h3>Les premiers outils</h3>
                        <p>
                            Ajouter progressivement les premiers outils
                            utilisables pendant une partie.
                        </p>
                        <small>À venir</small>
                    </div>
                </article>

                <article class="roadmap-item">
                    <div class="roadmap-point" aria-hidden="true">⚔</div>
                    <div class="roadmap-card">
                        <span>Étape IV</span>
                        <h3>Systèmes avancés</h3>
                        <p>
                            Explorer React, la gestion d'état, les données
                            complexes et les interactions plus importantes.
                        </p>
                        <small>À venir</small>
                    </div>
                </article>

                <article class="roadmap-item">
                    <div class="roadmap-point" aria-hidden="true">🐉</div>
                    <div class="roadmap-card">
                        <span>Étape V</span>
                        <h3>Explorer la 3D</h3>
                        <p>
                            Découvrir Three.js et expérimenter avec des
                            environnements ou objets 3D sur le web.
                        </p>
                        <small>Expérimentation future</small>
                    </div>
                </article>
            </div>
        </section>

        <!-- CE QUE J'APPRENDS -->
        <section class="section">
            <div class="section-heading">
                <p class="section-eyebrow">✦ Mon entraînement</p>
                <h2 class="section-title">Ce projet me permet d'apprendre.</h2>
            </div>

            <div class="learning-grid">
                <article class="learning-card">
                    <span aria-hidden="true">⚔️</span>
                    <h3>JavaScript</h3>
                    <p>Approfondir la manipulation du DOM, les données et les interactions complexes.</p>
                </article>

                <article class="learning-card">
                    <span aria-hidden="true">🔮</span>
                    <h3>React</h3>
                    <p>Découvrir une nouvelle manière de construire et organiser une application web.</p>
                </article>

                <article class="learning-card">
                    <span aria-hidden="true">🌌</span>
                    <h3>Three.js</h3>
                    <p>Explorer la 3D dans le navigateur et comprendre ses possibilités pour les interfaces web.</p>
                </article>

                <article class="learning-card">
                    <span aria-hidden="true">📚</span>
                    <h3>Architecture</h3>
                    <p>Apprendre à organiser un projet qui devient progressivement plus important.</p>
                </article>

                <article class="learning-card">
                    <span aria-hidden="true">🧩</span>
                    <h3>Données</h3>
                    <p>Manipuler des informations complexes et réfléchir à leur organisation.</p>
                </article>

                <article class="learning-card">
                    <span aria-hidden="true">🎨</span>
                    <h3>Interface</h3>
                    <p>Concevoir des interfaces capables de rester lisibles malgré un grand nombre de fonctionnalités.</p>
                </article>
            </div>
        </section>

        <!-- PROCHAINES AVENTURES -->
        <section class="section">
            <div class="future-panel">
                <div class="future-rune" aria-hidden="true">✦</div>
                <p class="section-eyebrow">✦ Prochaines aventures</p>
                <h2>Le grimoire est encore loin d'être terminé.</h2>
                <p>
                    De nouvelles fonctionnalités pourront apparaître
                    au fur et à mesure que mes compétences évolueront.
                    L'objectif n'est pas seulement de terminer une
                    application, mais de documenter tout le chemin
                    parcouru pour y arriver.
                </p>

                <div class="future-tags">
                    <span class="tag tag-sauge">React</span>
                    <span class="tag tag-sauge">Three.js</span>
                    <span class="tag tag-pierre">JavaScript</span>
                    <span class="tag tag-pierre">3D</span>
                    <span class="tag tag-pierre">UI</span>
                </div>
            </div>
        </section>
    </main>

    <!-- Modale d'une fonctionnalité (remplie par wip.js) -->
    <div
        id="feature-modal"
        class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/70 p-6 backdrop-blur-sm"
        role="dialog"
        aria-modal="true"
        aria-labelledby="feature-modal-title"
    >
        <div class="feature-modal">
            <button id="close-feature-modal" type="button" class="feature-modal-close" aria-label="Fermer">×</button>

            <div id="feature-modal-icon" class="feature-modal-icon"></div>
            <span id="feature-modal-status" class="feature-modal-status"></span>
            <h2 id="feature-modal-title">Fonctionnalité</h2>
            <p id="feature-modal-description"></p>

            <div class="feature-modal-divider"></div>

            <span class="feature-modal-subtitle">Objectifs</span>
            <ul id="feature-modal-goals" class="feature-modal-list"></ul>

            <button id="close-feature-modal-bottom" type="button" class="btn btn-primary mt-8 w-full">
                Fermer le grimoire
            </button>
        </div>
    </div>

    <footer class="footer-dark border-t border-cuir-800 bg-cuir-900/90 dark:border-pierre-800 dark:bg-pierre-950">
        <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-6 py-8 text-center md:flex-row md:text-left">
            <p class="text-sm text-parchemin-400">© 2026 Chhoeum Brandon — Portfolio</p>
            <a href={base} class="arrow-link">
                Retour à l'accueil <span class="arrow">→</span>
            </a>
        </div>
    </footer>

    <script>
        import "../scripts/wip.js";
    </script>
</BaseLayout>
