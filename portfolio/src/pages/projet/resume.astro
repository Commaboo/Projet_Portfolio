                                placeholder="Votre message..."
                                class="mt-2 w-full resize-none rounded-lg border border-parchemin-300 bg-white px-4 py-3 font-sans outline-none transition focus:border-accent-500 focus:ring-2 focus:ring-accent-500/20"
                            ></textarea>
                        </div>

                        <button
                            type="submit"
                            class="w-full rounded-lg bg-accent-500 px-6 py-4 font-sans font-bold text-cuir-950 transition duration-300 hover:-translate-y-1 hover:bg-accent-400"
                        >
