---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Brandon Chhoeum — Portfolio d'un étudiant développeur web" description="Portfolio de Brandon Chhoeum, étudiant en informatique à EPITECH Toulouse : projets web, parcours d'apprentissage et contact, dans un univers fantasy." preloadHero>
    <Nav active="home" />

    <main>
        <!-- HERO -->
        <section class="relative flex min-h-screen items-center overflow-hidden">
            <div
                class="absolute inset-0 scale-105 bg-cover bg-center blur-[3px]"
                style={`background-image: url('${base}images/bg_hero_index.webp');`}
                aria-hidden="true"
            ></div>
            <div class="absolute inset-0 bg-cuir-950/60" aria-hidden="true"></div>

            <div class="relative z-10 mx-auto w-full max-w-7xl px-6 py-32">
                <div class="max-w-3xl">
                    <div class="mb-6">
                        <span class="badge badge-accent">✦ Étudiant EPITECH</span>
                    </div>

                    <h1 class="text-5xl font-bold leading-tight text-parchemin-50 md:text-6xl lg:text-7xl">
                        Mes aventures
                        <span class="text-accent-300">encapsulées</span>
                        en expériences.
                    </h1>

                    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-parchemin-200 md:text-xl">
                        Étudiant en informatique, je transforme mes idées
                        en projets et mes apprentissages en expériences.
                        Bienvenue dans mon univers où le développement
                        rencontre un imaginaire fantastique et médiéval.
                    </p>

                    <div class="mt-8 flex flex-col gap-4 sm:flex-row">
                        <a href={`${base}projects/`} class="btn btn-primary">
                            Découvrir mes projets <span class="arrow">→</span>
                        </a>
                        <a href={`${base}contact/`} class="btn btn-secondary">
                            Me contacter
                        </a>
                    </div>
                </div>
            </div>

            <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-center text-parchemin-200/70" aria-hidden="true">
                <span class="block text-xs uppercase tracking-[0.25em]">Explorer</span>
                <span class="mt-2 block animate-bounce text-lg">↓</span>
            </div>
        </section>

        <!-- PROJETS MIS EN AVANT -->
        <section class="section section-parchment">
            <div class="section-heading reveal">
                <p class="section-eyebrow">✦ Mon grimoire</p>
                <h2 class="section-title">Quelques aventures de mon parcours</h2>
                <p class="section-description">
                    Chaque projet représente une étape de mon
                    apprentissage, une nouvelle compétence découverte
                    ou une idée que j'ai voulu transformer en expérience.
                </p>
            </div>

            <div class="grid gap-8 md:grid-cols-2">
                <article class="fantasy-card project-card">
                    <div class="project-magic-card magic-theme-ember">
                        <div class="magic-orbit magic-orbit-outer"></div>
                        <div class="magic-orbit magic-orbit-inner"></div>
                        <div class="magic-glow"></div>
                        <div class="magic-rune">✦</div>
                        <div class="magic-particles" aria-hidden="true">
                            <span>✦</span><span>◇</span><span>✧</span><span>·</span><span>✦</span><span>◇</span>
                        </div>
                        <div class="magic-card-content">
                            <span class="magic-card-label">Projet terminé</span>
                            <strong>CV interactif</strong>
                        </div>
                    </div>

                    <div class="p-6">
                        <span class="tag tag-sauge">Septembre 2026</span>
                        <h3 class="mt-4 text-2xl font-bold text-cuir-900 dark:text-parchemin-100">CV interactif</h3>
                        <p class="mt-3 leading-relaxed text-cuir-600 dark:text-parchemin-300">
                            Transformer un CV classique en une
                            expérience web plus interactive,
                            en travaillant sur la structure,
                            le design et les interactions.
                        </p>
                        <a href={`${base}projects/`} class="arrow-link mt-5">
                            Voir le projet <span class="arrow">→</span>
                        </a>
                    </div>
                </article>

                <article class="fantasy-card project-card">
                    <div class="project-magic-card magic-theme-arcane">
                        <div class="magic-orbit magic-orbit-outer"></div>
                        <div class="magic-orbit magic-orbit-inner"></div>
                        <div class="magic-glow"></div>
                        <div class="magic-rune">◇</div>
                        <div class="magic-particles" aria-hidden="true">
                            <span>✦</span><span>◇</span><span>✧</span><span>·</span><span>✦</span><span>◇</span>
                        </div>
                        <div class="magic-card-content">
                            <span class="magic-card-label">Projet terminé</span>
                            <strong>Parcours Python</strong>
                        </div>
                    </div>

                    <div class="p-6">
                        <span class="tag tag-sauge">Septembre 2026</span>
                        <h3 class="mt-4 text-2xl font-bold text-cuir-900 dark:text-parchemin-100">Parcours Python</h3>
                        <p class="mt-3 leading-relaxed text-cuir-600 dark:text-parchemin-300">
                            Un parcours d'apprentissage autour
                            des fondamentaux de Python, des exercices
                            pratiques et de la création d'un jeu
                            avec Pygame.
                        </p>
                        <a href={`${base}projects/`} class="arrow-link mt-5">
                            Voir le projet <span class="arrow">→</span>
                        </a>
                    </div>
                </article>

                <article class="fantasy-card project-card">
                    <div class="project-magic-card magic-theme-sage">
                        <div class="magic-orbit magic-orbit-outer"></div>
                        <div class="magic-orbit magic-orbit-inner"></div>
                        <div class="magic-glow"></div>
                        <div class="magic-rune">✧</div>
                        <div class="magic-particles" aria-hidden="true">
                            <span>✦</span><span>◇</span><span>✧</span><span>·</span><span>✦</span><span>◇</span>
                        </div>
                        <div class="magic-card-content">
                            <span class="magic-card-label">Projet en cours</span>
                            <strong>Rôle &amp; Fairies</strong>
                        </div>
                    </div>

                    <div class="p-6">
                        <span class="tag tag-sauge">2026 → aujourd'hui</span>
                        <h3 class="mt-4 text-2xl font-bold text-cuir-900 dark:text-parchemin-100">Rôle &amp; Fairies</h3>
                        <p class="mt-3 leading-relaxed text-cuir-600 dark:text-parchemin-300">
                            Un projet personnel autour du jeu de rôle,
                            du développement web et de l'exploration
                            de nouvelles technologies.
                        </p>
                        <a href={`${base}wip/`} class="arrow-link mt-5">
                            Découvrir l'aventure <span class="arrow">→</span>
                        </a>
                    </div>
                </article>

                <article class="fantasy-card project-card">
                    <div class="project-magic-card magic-theme-parchment">
                        <div class="magic-orbit magic-orbit-outer"></div>
                        <div class="magic-orbit magic-orbit-inner"></div>
                        <div class="magic-glow"></div>
                        <div class="magic-rune">❖</div>
                        <div class="magic-particles" aria-hidden="true">
                            <span>✦</span><span>◇</span><span>✧</span><span>·</span><span>✦</span><span>◇</span>
                        </div>
                        <div class="magic-card-content">
                            <span class="magic-card-label">Projet en cours</span>
                            <strong>Portfolio personnel</strong>
                        </div>
                    </div>

                    <div class="p-6">
                        <span class="tag tag-sauge">2026 → aujourd'hui</span>
                        <h3 class="mt-4 text-2xl font-bold text-cuir-900 dark:text-parchemin-100">Portfolio personnel</h3>
                        <p class="mt-3 leading-relaxed text-cuir-600 dark:text-parchemin-300">
                            Mon premier véritable univers web,
                            conçu pour présenter mon parcours,
                            mes projets et les compétences que
                            je développe.
                        </p>
                        <a href={`${base}projects/`} class="arrow-link mt-5">
                            Voir mes projets <span class="arrow">→</span>
                        </a>
                    </div>
                </article>
            </div>

            <div class="reveal mt-12 text-center">
                <a href={`${base}projects/`} class="btn btn-primary">
                    Consulter toutes mes aventures <span class="arrow">→</span>
                </a>
            </div>
        </section>

        <!-- PRÉSENTATION -->
        <section class="section section-sauge">
            <div class="mx-auto grid max-w-7xl items-center gap-12 md:grid-cols-2">
                <div class="reveal">
                    <p class="section-eyebrow">✦ Mon parcours</p>
                    <h2 class="text-3xl font-bold text-cuir-900 md:text-4xl dark:text-parchemin-100">
                        Apprendre, expérimenter,
                        construire.
                    </h2>
                    <p class="mt-5 leading-relaxed text-cuir-700 dark:text-parchemin-300">
                        Je suis étudiant en informatique et je construis
                        progressivement mes compétences à travers des
                        projets concrets.
                    </p>
                    <p class="mt-4 leading-relaxed text-cuir-700 dark:text-parchemin-300">
                        J'aime particulièrement comprendre comment les
                        choses fonctionnent, expérimenter de nouvelles
                        idées et transformer mes apprentissages en
                        réalisations concrètes.
                    </p>
                    <a href={`${base}about/`} class="arrow-link mt-6">
                        Découvrir mon parcours <span class="arrow">→</span>
                    </a>
                </div>

                <div class="reveal flex justify-center">
                    <div class="relative flex h-72 w-full max-w-md items-center justify-center overflow-hidden rounded-2xl border border-cuir-300 bg-cuir-900 p-8 shadow-xl dark:border-pierre-700">
                        <div class="absolute h-48 w-48 rounded-full border border-parchemin-300/20" aria-hidden="true"></div>
                        <div class="absolute h-32 w-32 rounded-full border border-accent-300/30" aria-hidden="true"></div>

                        <div class="relative z-10 text-center text-parchemin-100">
                            <div class="text-5xl text-accent-300" aria-hidden="true">✦</div>
                            <p class="mt-4 text-lg font-semibold">Chaque projet est une nouvelle aventure.</p>
                            <p class="mt-2 text-sm text-parchemin-300">Et chaque aventure m'apprend quelque chose.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CONTACT -->
        <section class="section section-parchment">
            <div class="reveal mx-auto max-w-3xl text-center">
                <p class="section-eyebrow">✦ Une nouvelle quête ?</p>
                <h2 class="section-title">Échangeons quelques mots.</h2>
                <p class="section-description">
                    Une idée, une question ou simplement envie
                    de discuter développement web ?
                    Ma boîte aux lettres est ouverte.
                </p>
                <a href={`${base}contact/`} class="btn btn-primary mt-8">
                    Me contacter <span class="arrow">→</span>
                </a>
            </div>
        </section>
    </main>

    <footer class="footer-light border-t border-cuir-200 bg-parchemin-600 dark:border-pierre-800 dark:bg-pierre-950">
        <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-6 py-8 text-center md:flex-row md:text-left">
            <div class="flex flex-col gap-1">
                <p class="text-sm text-cuir-800 dark:text-parchemin-400">© 2026 Chhoeum Brandon — Portfolio</p>
                <p class="photo-credit text-sm text-cuir-800 dark:text-parchemin-400">
                    Photo d'en-tête : <a href="https://www.pexels.com/photo/rocky-landscape-with-a-mountain-stream-and-clouds-15575235/" target="_blank" rel="noopener noreferrer">Jozsef Mihalyi</a> sur Pexels
                </p>
            </div>
            <a href={`${base}contact/`} class="arrow-link">
                Me contacter <span class="arrow">→</span>
            </a>
        </div>
    </footer>
</BaseLayout>
